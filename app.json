{
  "expo": {
    "name": "Moonhub",
    "slug": "moonhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moonhub.app"
    },
    "android": {
      "package": "com.moonhub.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video"
    ]
  }
}
