    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monhub.jobs"
    },
    "android": {
      "package": "com.monhub.jobs"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      "expo-status-bar",
      "expo-font"
    ]
  }
}
