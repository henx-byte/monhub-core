{
  "id": "anilist",
  "name": "AniList",
  "supportedTypes": ["ANIME"],
  "version": "1.0.0",
  "popularCode": "const gqlQuery = `query ($page: Int, $perPage: Int, $type: MediaType) { Page(page: $page, perPage: $perPage) { pageInfo { hasNextPage } media(type: $type, sort: TRENDING_DESC) { id title { romaji english } coverImage { extraLarge large color } bannerImage averageScore seasonYear startDate { year } description genres status chapters trailer { id site } } } }`; const res = await fetch('https://graphql.anilist.co', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ query: gqlQuery, variables: { page, perPage: 12, type } }) }); const j = await res.json(); if (j.errors) throw new Error(j.errors[0].message); return { media: j.data?.Page?.media || [], hasNext: j.data?.Page?.pageInfo?.hasNextPage || false };",
  "searchCode": "const gqlQuery = `query ($search: String, $type: MediaType) { Page(page: 1, perPage: 9) { media(type: $type, search: $search) { id title { romaji english } coverImage { extraLarge large color } bannerImage averageScore seasonYear startDate { year } description genres status chapters trailer { id site } } } }`; const res = await fetch('https://graphql.anilist.co', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ query: gqlQuery, variables: { search: query, type } }) }); const j = await res.json(); return j.data?.Page?.media || [];",
  "detailCode": "const gqlQuery = `query ($id: Int, $type: MediaType) { Media(id: $id, type: $type) { id title { romaji english native } coverImage { extraLarge large color } bannerImage averageScore description genres status episodes chapters trailer { id site } studios { nodes { name } } } }`; const res = await fetch('https://graphql.anilist.co', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ query: gqlQuery, variables: { id: parseInt(id), type } }) }); const j = await res.json(); return j.data?.Media || null;",
  "streamCode": "return { type: 'youtube', id: 'dQw4w9WgXcQ', url: 'https://www.youtube.com/watch?v=dQw4w9WgXcQ' };"
}
